# Copy to .env.local for development, then restart Metro.
# EXPO_PUBLIC_* values are bundled into the app. Do not put private credentials here.
EXPO_PUBLIC_SOLANA_CLUSTER=devnet

# The Seeker co-signer Worker (worker/README.md).
# Empty: "Seeker holders only" is not offered.
EXPO_PUBLIC_SEEKER_COSIGNER_URL=https://cosign.erashot.app

# Devnet only: a classic SPL Token mint standing in for SKR as a price unit. Unset: SOL prices only.
# Mainnet always offers SKR (SKRbvo6Gf7GondiT3BbTfuRDPqLWei4j2Qy2NPGZhW3).
# EXPO_PUBLIC_PRICE_TOKEN_MINT=

# Optional, local devnet debug builds only: a devnet test session payer.
# Opens a wallet funding review on launch. Remove after funding; excluded from release bundles.
# EXPO_PUBLIC_DEVNET_TEST_PAYER=

# Optional HTTPS RPC proxy URL. Keep provider credentials on the proxy server.
# EXPO_PUBLIC_SOLANA_RPC_URL=https://your-rpc-proxy.example
