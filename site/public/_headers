# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
# `collect/index.html` and `404.html` repeat their CSP as a <meta> (minus `frame-ancestors`, which
# a <meta> ignores). Edit both copies together.

# No HSTS `preload`: `.app` is already preloaded at the TLD.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), browsing-topics=(), payment=(), usb=(), hid=(), serial=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Static pages: no script, no inline style. File paths are listed beside served paths.
/
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/index.html
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/privacy
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/privacy.html
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# `/terms` and `/terms/index.html` redirect to `/terms/`; all three are covered.
/terms
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/terms/
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/terms/index.html
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Read by the app (`src/moderation/core.ts`); short max-age so edits land within minutes.
/moderation.json
  Cache-Control: public, max-age=300

# A 404 served for any other path gets only the /* baseline plus 404.html's <meta> policy.
/404.html
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Static policy plus one hashed inline script that sets the "Open in Signshot" link. No fetches,
# no DOM XSS sinks, so Trusted Types is enforced with no policies.
/collect/*
  Content-Security-Policy: default-src 'none'; script-src 'sha256-egJvXt1btdP6enz/y1WzhQopgbniaOsQWWfcQy4VNQM='; style-src 'self'; img-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; require-trusted-types-for 'script'; trusted-types 'none'; frame-ancestors 'none'

# Android accepts assetlinks.json only as JSON; short max-age so a certificate rotation propagates.
# Everything here is labelled JSON, so a non-JSON file needs a narrower rule first.
/.well-known/*
  Content-Type: application/json
  Cache-Control: public, max-age=300
